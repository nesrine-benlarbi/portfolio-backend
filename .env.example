# ---------------------------------------------------------------
# Modèle de configuration. Copier ce fichier en `.env` et renseigner
# les valeurs réelles — `.env` est exclu du dépôt par `.gitignore`.
# ---------------------------------------------------------------

PORT=3001
# Origine autorisée par CORS : l'adresse du front-end
CLIENT_URL=http://localhost:5173

# Base de données — utiliser un compte dédié à l'application,
# jamais `root`. Droits nécessaires : SELECT, INSERT, UPDATE, DELETE
# sur la seule base du projet.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=
DB_PASSWORD=

# Clé de signature des jetons JWT — doit différer entre développement
# et production, et rester longue et aléatoire.
JWT_SECRET=

# Formulaire de contact — envoi via l'API HTTP de Resend.
# Le SMTP n'est pas utilisable : l'hébergeur bloque les ports 25, 465 et 587.
# Clé à créer sur resend.com, puis à renseigner côté hébergeur uniquement.
RESEND_API_KEY=
# Expéditeur. Sans nom de domaine vérifié, garder l'adresse de démarrage
# fournie par Resend, qui n'écrit qu'au titulaire du compte.
MAIL_FROM=L'Atelier <onboarding@resend.dev>
# Destinataire des notifications du formulaire
MAIL_TO=
